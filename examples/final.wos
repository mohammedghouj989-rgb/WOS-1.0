print("=== WOS Test ===");

print("1. Variables:");
int x = 10;
print(x);

print("2. Lists (int):");
list<int> numbers = [100, 200, 300];
print(numbers[0]);
print(numbers[1]);
print(numbers[2]);

print("3. Lists (string):");
list<string> names = ["Ali", "Sara", "Omar"];
print(names[0]);
print(names[1]);
print(names[2]);

print("4. Function:");
function add(int a, int b) {
    return a + b;
}
int result = add(5, 7);
print(result);

print("5. Struct:");
struct Point {
    int x;
    int y;
}
Point p = Point(50, 60);
print(p.x);
print(p.y);

print("6. Alloc/Free:");
void* ptr = alloc(100);
print("allocated");
*ptr = 42;
print(*ptr);
free(ptr);
print("freed");

print("=== Done ===");
