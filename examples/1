// ============================================================
// PARSE GUI
// ============================================================
ASTNode *parse_gui(Parser *p) {
    Token type = parser_advance(p);

    if (strcmp(type.value, "button") == 0) {
        Token shape = parser_expect(p, TOKEN_KEYWORD, "expected shape");
        Token text = parser_expect(p, TOKEN_STRING, "expected text");
        Token position = parser_expect(p, TOKEN_KEYWORD, "expected position");
        ASTNode *node = ast_create(AST_GUI_BUTTON, text.value,
                                   type.line, type.column);
        ast_add_child(node, ast_create(AST_EXPRESSION, shape.value,
                                       shape.line, shape.column));
        ast_add_child(node, ast_create(AST_EXPRESSION, position.value,
                                       position.line, position.column));
        if (parser_check(p, TOKEN_NUMBER)) {
            Token w = parser_advance(p);
            parser_expect(p, TOKEN_IDENTIFIER, "expected 'x'");
            Token h = parser_expect(p, TOKEN_NUMBER, "expected height");
            ast_add_child(node, ast_create(AST_EXPRESSION, w.value,
                                           w.line, w.column));
            ast_add_child(node, ast_create(AST_EXPRESSION, h.value,
                                           h.line, h.column));
        }
        return node;
    }

    if (strcmp(type.value, "text") == 0) {
        Token text = parser_expect(p, TOKEN_STRING, "expected text");
        Token position = parser_expect(p, TOKEN_KEYWORD, "expected position");
        ASTNode *node = ast_create(AST_GUI_TEXT, text.value,
                                   type.line, type.column);
        ast_add_child(node, ast_create(AST_EXPRESSION, position.value,
                                       position.line, position.column));
        return node;
    }

    if (strcmp(type.value, "input") == 0) {
        Token text = parser_expect(p, TOKEN_STRING, "expected text");
        Token position = parser_expect(p, TOKEN_KEYWORD, "expected position");
        ASTNode *node = ast_create(AST_GUI_INPUT, text.value,
                                   type.line, type.column);
        ast_add_child(node, ast_create(AST_EXPRESSION, position.value,
                                       position.line, position.column));
        return node;
    }

    printf("Parse Error at line %d: unknown GUI keyword '%s'\n",
           type.line, type.value);
    p->has_error = 1;
    return NULL;
}

// ============================================================
// PARSE STATEMENT (DISPATCHER)
// ============================================================
ASTNode *parse_statement(Parser *p) {
    Token t = parser_peek(p);

    // Deref assignment: *p = value;
    if (t.type == TOKEN_OPERATOR && t.value && strcmp(t.value, "*") == 0) {
        Token next = parser_peek_next(p);
        if (next.type == TOKEN_IDENTIFIER) {
            Token after = p->tokens[p->position + 2];
            if (after.type == TOKEN_OPERATOR && after.value &&
                strcmp(after.value, "=") == 0) {
                return parse_deref_assign(p);
            }
        }
    }

    if (t.type == TOKEN_KEYWORD && t.value) {
        // Struct definitions
        if (strcmp(t.value, "struct") == 0) return parse_struct_def(p);
        if (strcmp(t.value, "library") == 0) return parse_library(p);
        if (strcmp(t.value, "import") == 0) return parse_import(p);
        if (strcmp(t.value, "use") == 0) return parse_import(p);

        // Memory
        if (strcmp(t.value, "alloc") == 0) return parse_alloc(p);
        if (strcmp(t.value, "free") == 0) return parse_free(p);

        // Type declarations
        if (strcmp(t.value, "int")    == 0 ||
            strcmp(t.value, "float")  == 0 ||
            strcmp(t.value, "double") == 0 ||
            strcmp(t.value, "bool")   == 0 ||
            strcmp(t.value, "string") == 0 ||
            strcmp(t.value, "void")   == 0 ||
            strcmp(t.value, "list")   == 0) {
            return parse_declaration(p);
        }

        // Statements
        if (strcmp(t.value, "print")    == 0) return parse_print(p);
        if (strcmp(t.value, "if")       == 0) return parse_if(p);
        if (strcmp(t.value, "while")    == 0) return parse_while(p);
        if (strcmp(t.value, "for")      == 0) return parse_for(p);
        if (strcmp(t.value, "function") == 0) return parse_function(p);
        if (strcmp(t.value, "return")   == 0) return parse_return(p);

        // GUI
        if (strcmp(t.value, "button")   == 0 ||
            strcmp(t.value, "text")     == 0 ||
            strcmp(t.value, "input")    == 0) return parse_gui(p);
    }

    // Block
    if (parser_check_punct(p, '{')) return parse_block(p);

    // Assignment / Member assignment / List assignment
    if (t.type == TOKEN_IDENTIFIER) {
        Token next = parser_peek_next(p);
        if (next.type == TOKEN_OPERATOR && next.value && strcmp(next.value, "=") == 0) {
            return parse_assignment(p);
        }
        if (next.type == TOKEN_PUNCTUATION && next.value &&
            (next.value[0] == '.' || next.value[0] == '[')) {
            return parse_assignment(p);
        }
    }

    // Expression statement
    ASTNode *expr = parse_comparison(p);
    if (expr) parser_expect_punct(p, ';', "expected ';'");
    return expr;
}

// ============================================================
// PARSE PROGRAM
// ============================================================
ASTNode *parse_program(Parser *p) {
    ASTNode *program = ast_create(AST_PROGRAM, NULL, 1, 1);

    while (!parser_check(p, TOKEN_EOF)) {
        Token t = parser_peek(p);
        if (t.type == TOKEN_KEYWORD && (!t.value || t.value[0] == '\0')) {
            parser_advance(p);
            continue;
        }
        int before = p->position;
        ASTNode *stmt = parse_statement(p);
        if (stmt) ast_add_child(program, stmt);
        if (p->position == before) break;
    }
    return program;
}

// ============================================================
// INCLUDE CODEGEN
// ============================================================
#include "codegen.c"

// ============================================================
// MAIN
// ============================================================
int main(int argc, char **argv) {
    if (argc < 2) {
        printf("Usage: %s <file.wos>\n", argv[0]);
        return 1;
    }

    char *source = read_file(argv[1]);
    if (!source) return 1;

    Lexer *lexer = lexer_create(source);
    lexer_tokenize_all(lexer);

    if (lexer->has_error) {
        printf("Lexer errors found.\n");
        lexer_free(lexer);
        free(source);
        return 1;
    }

    Parser parser;
    parser.tokens = lexer->tokens;
    parser.token_count = lexer->token_count;
    parser.position = 0;
    parser.has_error = 0;

    ASTNode *program = parse_program(&parser);

    if (parser.has_error) {
        printf("Errors found during parsing.\n");
        ast_free(program);
        lexer_free(lexer);
        free(source);
        return 1;
    }

    cg_generate(program, "output.c");

    int ret = system("clang output.c -o output 2>/dev/null");
    if (ret == 0) system("./output");
    else printf("Note: Could not compile output.c\n");

    ast_free(program);
    lexer_free(lexer);
    free(source);
    return 0;
}
